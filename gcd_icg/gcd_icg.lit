; REQUIRES: flow-gcd_icg
; RUN: %jq -e '[.steps[] | {name, state}] == [{"name":"Synthesis","state":"Success"}]' %flows/gcd_icg/default/home/flow.json
; RUN: %jq -e '.modules["\\gcd"].num_cells_by_type.ICGX0P5H7L == 2' %flows/gcd_icg/default/Synthesis_yosys/feature/Synthesis_stat.json
; RUN: %jq -e 'any(.paths[]; any(.stages[]; .cell == "ICGX0P5H7L"))' %flows/gcd_icg/default/Synthesis_yosys/feature/post_synthesis/timing_paths.json
