; REQUIRES: flow-Bstage-rv32e-64B-icache
; RUN: %jq -e "[.steps[].state] | all(. == \"Success\")" %flows/Bstage-rv32e-64B-icache/default/home/flow.json
; RUN: %jq -e '[.checklist[] | select(.category == "quality_gate")] as $g | if ($g | length) == 0 then error("no quality_gate items") else ([$g[] | select(.state != "pass" or .blocked) | {id, state, blocked}] as $bad | if ($bad | length) == 0 then true else error($bad | @json) end) end' %flows/Bstage-rv32e-64B-icache/default/home/checklist.json
