; REQUIRES: flow-xtea
; RUN: %filecheck --input-file %flows/xtea/default/Synthesis_yosys/report/Synthesis_check.rpt %S/checks/synthesis.check
; RUN: %filecheck --input-file %flows/xtea/default/Synthesis_yosys/analysis/qor_summary.json %S/checks/qor_summary.check
; RUN: %jq -e "[.steps[].state] | all(. == \"Success\")" %flows/xtea/default/home/flow.json
;
; CSV signoff gates against the real workspace (contract: %S/../profiles/signoff.yml).
; REQUIRES: csv-gates
; RUN: %export_csv --workspace %flows/xtea/default --out-dir %t/out --spec %spec
; RUN: %filecheck --input-file %t/out/reports/metrics.check.txt %S/../profiles/signoff_gates.check
; RUN: %jq -e ".schema_version == 1 and .kind == \"signoff_csv_run\" and .gates_failed == 0" %t/out/reports/run_manifest.json
