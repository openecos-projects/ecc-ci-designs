; REQUIRES: flow-Cstage-rv32e-axi
; RUN: %jq -e "[.steps[].state] | all(. == \"Success\")" %flows/Cstage-rv32e-axi/default/home/flow.json
; RUN: %jq -e '[.checklist[] | select(.category == "quality_gate")] as $g | if ($g | length) == 0 then error("no quality_gate items") else ([$g[] | select(.state != "pass" or .blocked) | {id, state, blocked}] as $bad | if ($bad | length) == 0 then true else error($bad | @json) end) end' %flows/Cstage-rv32e-axi/default/home/checklist.json
